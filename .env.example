# Copy to .env and fill in. Never commit .env.

# Which stack to run: "local" (PostgreSQL + Ollama) or "gcp" (Firestore + Gemini on Vertex AI)
SPRING_PROFILES_ACTIVE=local

# ---- Shared ----
STAFF_PIN=2468
# At least 16 characters. Generate one with: openssl rand -hex 32
STAFF_TOKEN_SECRET=replace-with-a-long-random-string
DEFAULT_BARISTAS=2
# Port the app listens on (default 8080).
# PORT=8080

# ---- local profile ----
DATABASE_URL=jdbc:postgresql://localhost:5432/googlecoffee
DATABASE_USER=googlecoffee
DATABASE_PASSWORD=googlecoffee
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=90
# Host port for the Docker Postgres (default 5432). If you change it, change the port in DATABASE_URL too.
# POSTGRES_PORT=5432
# ./run-local.sh starts Postgres in Docker by default. Set to false to use your own Postgres at DATABASE_URL.
# USE_DOCKER_POSTGRES=true
# Note: with "docker compose --profile app up" the app container always reaches Postgres at postgres:5432 and
# Ollama at host.docker.internal:11434, whatever DATABASE_URL and OLLAMA_BASE_URL say.

# ---- gcp profile ----
GCP_PROJECT_ID=your-project-id
FIRESTORE_DATABASE=google-coffee
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LOCATION=us-central1
# GEMINI_TIMEOUT_SECONDS=25
# Used by deploy.sh and setup-cicd.sh (defaults shown).
# REGION=asia-south1
# SERVICE=google-coffee
